# 复制为 .env 后填写（不要把 .env 提交到 Git）

PORT=8787
NODE_ENV=development

# 前端地址（OAuth 成功后跳回这里）
FRONTEND_URL=http://localhost:5173

# 后端对外地址（须与 GitHub OAuth 回调一致）
# 本地：http://localhost:8787
# 阿里云：https://你的域名 或 http://公网IP:8787
BACKEND_URL=http://localhost:8787

# GitHub OAuth App（https://github.com/settings/developers）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 随便生成一段长随机字符串，用于签名登录 Cookie
# 可用：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=请改成一串很长的随机字符

# 留言数据文件路径（部署到阿里云后会写在服务器磁盘上）
DATA_FILE=./data/messages.json

# 草地花园：花朵数据与上传图片目录（同样写在阿里云磁盘上）
FLOWERS_FILE=./data/flowers.json
UPLOAD_DIR=./data/uploads/garden

# 允许的前端来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173
